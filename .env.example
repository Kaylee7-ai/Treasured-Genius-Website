# Treasured Genius must use its own dedicated Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only; use the publishable key above for new projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key: use the Supabase Secret API key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy fallback only; keep server-side and never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=

# The owner account email, comma-separated if there is more than one.
STORE_OWNER_EMAILS=

# Optional extra salt for the request rate-limit hash. Use a long random value.
# When omitted, the server derives this from the Supabase secret key.
CUSTOM_REQUEST_RATE_LIMIT_SECRET=

# Optional email notification when a new custom request is saved.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
STORE_OWNER_NOTIFICATION_EMAIL=
